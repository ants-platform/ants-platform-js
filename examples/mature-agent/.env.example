# --- Ants Platform (required: this is where traces are sent) ---
ANTS_PLATFORM_PUBLIC_KEY=pk_...
ANTS_PLATFORM_SECRET_KEY=sk_...
# Defaults to https://api.agenticants.ai if unset.
ANTS_PLATFORM_BASE_URL=https://api.agenticants.ai
# Tags every trace with an environment in the Ants UI.
ANTS_PLATFORM_ENVIRONMENT=examples

# --- OpenAI (required: real LLM calls) ---
OPENAI_API_KEY=sk-...
# Fast/cheap model used for routing + evaluation lookups.
ANTS_FAST_MODEL=gpt-4o-mini
# Higher-reasoning model used by the researcher sub-agent + final synthesis.
ANTS_REASONING_MODEL=gpt-4o

# --- Guardrails (optional: real policy checks) ---
# Format is "publicKey:secretKey". If unset, the guardrail step is skipped
# but the example still runs.
ANTS_GUARDRAILS_API_KEY=pk_...:sk_...
ANTS_GUARDRAILS_AGENT_ID=ops-copilot
